---
import Base from '../../layouts/Base.astro';
import { clinic } from '../../data/clinic';

const key = clinic.web3formsRegistrationKey;
const formReady = key && key !== 'PLACEHOLDER';

/** Bilingual option lists, mirroring the printed form exactly. */
const conditions = [
  ['Heart disease / chest pain', 'हृदय रोग / सीने में दर्द'],
  ['Heart attack', 'हार्ट अटैक'],
  ['Heart murmur / valve problem', 'हृदय की धड़कन में गड़बड़ी / वाल्व रोग'],
  ['Artificial heart valve', 'कृत्रिम हृदय वाल्व'],
  ['Rheumatic fever', 'रूमेटिक फीवर'],
  ['Pacemaker', 'पेसमेकर लगा है'],
  ['High BP', 'उच्च रक्तचाप (हाई बी.पी.)'],
  ['Low BP', 'निम्न रक्तचाप (लो बी.पी.)'],
  ['Paralysis / stroke', 'लकवा / स्ट्रोक'],
  ['Anaemia / low haemoglobin', 'खून की कमी (एनीमिया)'],
  ['Bleeding that does not stop', 'खून का न रुकना'],
  ['Thalassaemia / sickle cell', 'थैलेसीमिया / सिकल सेल'],
  ['Weak bones / osteoporosis', 'हड्डियों का कमज़ोर होना'],
  ['Joint replacement', 'जोड़ प्रत्यारोपण'],
  ['Arthritis', 'गठिया (आर्थराइटिस)'],
  ['Diabetes (sugar)', 'मधुमेह (शुगर)'],
  ['Thyroid problem', 'थायरॉइड की समस्या'],
  ['Epilepsy / fits', 'मिर्गी / दौरे पड़ना'],
  ['Asthma / breathing problem', 'दमा (अस्थमा) / साँस की तकलीफ़'],
  ['Tuberculosis (TB)', 'क्षय रोग (टी.बी.)'],
  ['Kidney disease / dialysis', 'गुर्दे (किडनी) का रोग / डायलिसिस'],
  ['Liver disease', 'यकृत (लिवर) का रोग'],
  ['Jaundice / Hepatitis B or C', 'पीलिया / हेपेटाइटिस बी या सी'],
  ['HIV', 'एच.आई.वी.'],
  ['Cancer', 'कैंसर'],
  ['Radiotherapy to head or neck', 'सिर या गले की रेडियोथेरेपी'],
  ['Chemotherapy', 'कीमोथेरेपी'],
  ['Acidity / stomach ulcer', 'अम्लता (एसिडिटी) / पेट का अल्सर'],
  ['Fainting / giddiness', 'चक्कर आना / बेहोशी'],
  ['Mental health condition', 'मानसिक स्वास्थ्य संबंधी समस्या'],
];

const medicineFlags = [
  ['Blood-thinning medicine (Ecosprin/aspirin, clopidogrel, warfarin, apixaban, rivaroxaban)',
   'खून पतला करने वाली दवा (इकोस्प्रिन/एस्पिरिन, क्लोपिडोग्रेल, वारफ़ेरिन)'],
  ['Medicine for weak bones — bisphosphonates or denosumab (Fosamax, Zoledronic acid, Prolia)',
   'हड्डियों की कमज़ोरी की दवा — बिसफ़ॉस्फ़ोनेट या डेनोसुमैब'],
  ['Steroids (prednisolone / Wysolone)', 'स्टेरॉयड (प्रेडनिसोलोन / वायसोलोन)'],
  ['Immunosuppressant medicine, or low immunity', 'रोग-प्रतिरोधक क्षमता घटाने वाली दवा, या कम प्रतिरोधक क्षमता'],
  ['Told to take antibiotics before dental treatment', 'दंत उपचार से पहले एंटीबायोटिक लेने की सलाह दी गई है'],
  ['Pregnant', 'गर्भवती'],
  ['Breastfeeding', 'स्तनपान करा रही हूँ'],
];

const allergies = [
  ['Penicillin / amoxicillin', 'पेनिसिलिन / एमोक्सिसिलिन'],
  ['Other antibiotic', 'अन्य एंटीबायोटिक'],
  ['Local anaesthetic (injection)', 'सुन्न करने का इंजेक्शन'],
  ['Latex / rubber gloves', 'लेटेक्स / रबर के दस्ताने'],
  ['Aspirin or painkillers', 'एस्पिरिन या दर्द निवारक दवा'],
  ['Iodine / Betadine', 'आयोडीन / बीटाडीन'],
  ['Metals', 'धातु'],
  ['Food', 'भोजन'],
  ['No known allergy', 'कोई ज्ञात एलर्जी नहीं'],
];

const symptoms = [
  ['Bleeding gums', 'मसूड़ों से खून आना'],
  ['Sensitivity to hot / cold / sweet', 'ठंडा / गरम / मीठा लगना'],
  ['Bad breath', 'मुँह से दुर्गंध'],
  ['Loose teeth', 'दाँत हिलना'],
  ['Food getting stuck between teeth', 'दाँतों के बीच खाना फँसना'],
  ['Dry mouth', 'मुँह सूखना'],
  ['Mouth ulcers that do not heal', 'मुँह के छाले जो ठीक नहीं होते'],
  ['White or red patch in the mouth', 'मुँह में सफ़ेद या लाल धब्बा'],
  ['Burning sensation in mouth', 'मुँह में जलन'],
  ['Difficulty opening the mouth fully', 'मुँह पूरा खोलने में कठिनाई'],
  ['Clicking or pain in the jaw', 'जबड़े में आवाज़ या दर्द'],
  ['Grinding teeth at night', 'रात में दाँत पीसना'],
  ['Difficulty chewing', 'चबाने में कठिनाई'],
  ['Unhappy with the look of my teeth', 'दाँतों की बनावट से असंतुष्ट'],
  ['Snoring', 'खर्राटे लेना'],
];

const pastTreatment = [
  ['Filling', 'भराई (फ़िलिंग)'],
  ['Cleaning / scaling', 'सफ़ाई (स्केलिंग)'],
  ['Root canal (RCT)', 'रूट कैनाल (आर.सी.टी.)'],
  ['Tooth extraction', 'दाँत निकलवाना'],
  ['Wisdom tooth removal', 'अक्ल दाढ़ निकलवाना'],
  ['Cap / crown / bridge', 'कैप / क्राउन / ब्रिज'],
  ['Denture', 'नकली दाँत'],
  ['Braces / aligners', 'तार / ब्रेसेज़ / अलाइनर'],
  ['Implant', 'इम्प्लांट'],
  ['Gum treatment', 'मसूड़ों का इलाज'],
  ['Teeth whitening', 'दाँत सफ़ेद कराना'],
];

const tobacco = [
  ['Cigarette / bidi', 'सिगरेट / बीड़ी'],
  ['Gutkha / khaini / zarda / mawa', 'गुटखा / खैनी / ज़र्दा / मावा'],
  ['Paan with tobacco', 'तंबाकू वाला पान'],
  ['Paan without tobacco', 'बिना तंबाकू का पान'],
  ['Supari (areca nut)', 'सुपारी'],
  ['Snuff / gul / mishri', 'सूँघने वाला तंबाकू / गुल / मिश्री'],
  ['Ex-user — have quit', 'पहले सेवन करते थे — छोड़ दिया'],
  ['No tobacco use', 'तंबाकू का सेवन नहीं करता/करती'],
];

const policies = [
  ['Consultation and treatment fees are payable at the time of the visit unless agreed otherwise.',
   'परामर्श एवं उपचार शुल्क का भुगतान उसी दिन करना होगा, जब तक कोई अन्य व्यवस्था तय न हो।'],
  ['For treatment beyond consultation and cleaning I will be given a written plan with an estimated cost. If clinical findings change, I will be told before any additional cost is incurred.',
   'परामर्श और सफ़ाई से आगे के उपचार के लिए मुझे लिखित योजना और अनुमानित खर्च दिया जाएगा। जाँच में बदलाव मिलने पर अतिरिक्त खर्च से पहले मुझे सूचित किया जाएगा।'],
  ['The clinic will assist with insurance paperwork, but approval and the amount payable are decided by my insurer or TPA. Any amount not covered is my responsibility.',
   'क्लिनिक बीमा कागज़ी कार्रवाई में सहायता करेगा, परंतु स्वीकृति और देय राशि का निर्णय बीमा कंपनी या TPA करती है। जो राशि शामिल नहीं है, उसका भुगतान मेरी ज़िम्मेदारी है।'],
  ['Some treatments (RCT, crowns, implants, braces) need several visits. Leaving treatment incomplete can damage the tooth.',
   'कुछ उपचारों (आर.सी.टी., क्राउन, इम्प्लांट, ब्रेसेज़) में कई बार आना पड़ता है। उपचार बीच में छोड़ने से दाँत को नुकसान हो सकता है।'],
];
---

<Base
  title="Patient registration form"
  description="Complete the Sri Shankara Dental Clinic patient registration form online before your visit."
  noindex={true}
>
  <section class="section form-page">
    <div class="wrap-narrow">
      <p class="eyebrow">Before your visit</p>
      <h1>Patient registration</h1>

      {!formReady ? (
        <div class="notice notice--warn">
          <h2>The online form is not live yet</h2>
          <p>
            It is not yet connected to the clinic inbox, so anything entered
            here would not reach us. Rather than let that happen silently, we
            have kept it switched off.
          </p>
          <p>
            Please <a href="/forms/">download the printable form</a> and bring
            it with you, or arrive ten minutes early and complete it at the desk.
          </p>
        </div>
      ) : (
        <>
          <p class="lede">
            About 8 minutes. Your answers save in this browser as you go, so you
            can stop and come back. Nothing is sent until you press submit.
          </p>
          <p class="pain-note">
            <strong>In pain, or had an injury?</strong> Please phone{' '}
            <a href={clinic.phoneHref}>{clinic.phone}</a> instead — we can advise
            you straight away and make time to see you.
          </p>

          <noscript>
            <div class="notice notice--warn">
              This form needs JavaScript. Please
              <a href="/forms/">download the printable version</a> instead.
            </div>
          </noscript>

          <form id="reg" novalidate>
            <!-- 1 -->
            <fieldset>
              <legend><span class="n">1</span> Your details <span class="hi">आपका विवरण</span></legend>

              <label class="field">
                <span>Full name <em class="hi">पूरा नाम</em> <b class="req">*</b></span>
                <input type="text" name="fullName" required autocomplete="name" />
              </label>

              <label class="field">
                <span>Father's / husband's name <em class="hi">पिता / पति का नाम</em></span>
                <input type="text" name="guardianName" />
              </label>

              <div class="pair">
                <label class="field">
                  <span>Date of birth <em class="hi">जन्म तिथि</em></span>
                  <input type="date" name="dob" />
                </label>
                <label class="field">
                  <span>or Age <em class="hi">अथवा आयु</em></span>
                  <input type="number" name="age" min="0" max="120" inputmode="numeric" />
                </label>
              </div>

              <div class="pair">
                <label class="field">
                  <span>Gender <em class="hi">लिंग</em></span>
                  <select name="gender">
                    <option value="">—</option>
                    <option>Male / पुरुष</option>
                    <option>Female / महिला</option>
                    <option>Other / अन्य</option>
                  </select>
                </label>
                <label class="field">
                  <span>Blood group <em class="hi">रक्त समूह</em></span>
                  <input type="text" name="bloodGroup" maxlength="8" />
                </label>
              </div>

              <div class="pair">
                <label class="field">
                  <span>Occupation <em class="hi">व्यवसाय</em></span>
                  <input type="text" name="occupation" />
                </label>
                <label class="field">
                  <span>Preferred language <em class="hi">पसंदीदा भाषा</em></span>
                  <select name="language">
                    <option value="">—</option>
                    <option>Hindi / हिन्दी</option>
                    <option>English / अंग्रेज़ी</option>
                    <option>Other / अन्य</option>
                  </select>
                </label>
              </div>

              <label class="field">
                <span>Address <em class="hi">पता</em></span>
                <textarea name="address" rows="2"></textarea>
              </label>

              <div class="trio">
                <label class="field">
                  <span>City <em class="hi">शहर</em></span>
                  <input type="text" name="city" value="Dehradun" />
                </label>
                <label class="field">
                  <span>State <em class="hi">राज्य</em></span>
                  <input type="text" name="state" value="Uttarakhand" />
                </label>
                <label class="field">
                  <span>PIN <em class="hi">पिन कोड</em></span>
                  <input type="text" name="pin" inputmode="numeric" maxlength="6" />
                </label>
              </div>

              <div class="pair">
                <label class="field">
                  <span>Mobile <em class="hi">मोबाइल नं.</em> <b class="req">*</b></span>
                  <input type="tel" name="mobile" required inputmode="tel" autocomplete="tel" />
                </label>
                <label class="field">
                  <span>Alternate number <em class="hi">वैकल्पिक नं.</em></span>
                  <input type="tel" name="mobileAlt" inputmode="tel" />
                </label>
              </div>

              <label class="field">
                <span>Email <em class="hi">ईमेल</em></span>
                <input type="email" name="email" autocomplete="email" />
              </label>

              <div class="pair">
                <label class="field">
                  <span>Is your mobile on WhatsApp? <em class="hi">व्हाट्सएप पर है?</em></span>
                  <select name="whatsapp">
                    <option value="">—</option>
                    <option>Yes / हाँ</option>
                    <option>No / नहीं</option>
                  </select>
                </label>
                <label class="field">
                  <span>Best way to contact you <em class="hi">संपर्क का तरीका</em></span>
                  <select name="contactPref">
                    <option value="">—</option>
                    <option>Call / कॉल</option>
                    <option>SMS / एस.एम.एस.</option>
                    <option>WhatsApp / व्हाट्सएप</option>
                    <option>Email / ईमेल</option>
                  </select>
                </label>
              </div>

              <label class="field">
                <span>How did you hear about us? <em class="hi">आप हमारे बारे में कैसे जाने?</em></span>
                <select name="referredBy">
                  <option value="">—</option>
                  <option>Doctor referral / डॉक्टर</option>
                  <option>Existing patient / पुराने रोगी</option>
                  <option>Online / Google</option>
                  <option>Social media / सोशल मीडिया</option>
                  <option>Insurance or TPA panel / बीमा पैनल</option>
                  <option>Passing by / स्वयं आए</option>
                  <option>Other / अन्य</option>
                </select>
              </label>
            </fieldset>

            <!-- 2 -->
            <fieldset>
              <legend><span class="n">2</span> Health ID, schemes &amp; insurance <span class="hi">हेल्थ आई.डी., योजना एवं बीमा</span></legend>
              <p class="hint">All optional. Only needed if you intend to claim.<br /><span class="hi">सभी वैकल्पिक। केवल दावा करने पर आवश्यक।</span></p>

              <label class="field">
                <span>ABHA number / address <em class="hi">आभा नंबर</em></span>
                <input type="text" name="abha" />
              </label>

              <div class="pair">
                <label class="field">
                  <span>Scheme <em class="hi">योजना</em></span>
                  <select name="scheme">
                    <option value="">None / कोई नहीं</option>
                    <option>Ayushman Bharat PM-JAY</option>
                    <option>CGHS</option>
                    <option>ECHS</option>
                    <option>ESIC</option>
                    <option>State scheme / राज्य की योजना</option>
                  </select>
                </label>
                <label class="field">
                  <span>Card number <em class="hi">कार्ड नंबर</em></span>
                  <input type="text" name="schemeCard" />
                </label>
              </div>

              <div class="pair">
                <label class="field">
                  <span>Insurer / TPA <em class="hi">बीमा कंपनी / TPA</em></span>
                  <input type="text" name="insurer" />
                </label>
                <label class="field">
                  <span>Policy number <em class="hi">पॉलिसी नं.</em></span>
                  <input type="text" name="policyNo" />
                </label>
              </div>

              <label class="check">
                <input type="checkbox" name="cashless" />
                <span>I am seeking cashless treatment <em class="hi">मैं कैशलेस उपचार चाहता/चाहती हूँ</em></span>
              </label>
              <p class="hint">Cashless treatment needs pre-authorisation from your insurer or TPA and depends on their approval.</p>
            </fieldset>

            <!-- 3 -->
            <fieldset>
              <legend><span class="n">3</span> If the patient is under 18 <span class="hi">यदि रोगी 18 वर्ष से कम है</span></legend>
              <p class="hint">Complete only if the patient is under 18, or cannot give consent themselves.</p>
              <div class="pair">
                <label class="field">
                  <span>Responsible person's name <em class="hi">उत्तरदायी व्यक्ति का नाम</em></span>
                  <input type="text" name="responsibleName" />
                </label>
                <label class="field">
                  <span>Relationship <em class="hi">संबंध</em></span>
                  <input type="text" name="responsibleRel" />
                </label>
              </div>
              <label class="field">
                <span>Their mobile <em class="hi">उनका मोबाइल नं.</em></span>
                <input type="tel" name="responsibleMobile" inputmode="tel" />
              </label>
            </fieldset>

            <!-- 4 -->
            <fieldset>
              <legend><span class="n">4</span> Emergency contact <span class="hi">आपातकालीन संपर्क</span></legend>
              <div class="trio">
                <label class="field">
                  <span>Name <em class="hi">नाम</em></span>
                  <input type="text" name="emergencyName" />
                </label>
                <label class="field">
                  <span>Relationship <em class="hi">संबंध</em></span>
                  <input type="text" name="emergencyRel" />
                </label>
                <label class="field">
                  <span>Mobile <em class="hi">मोबाइल नं.</em></span>
                  <input type="tel" name="emergencyMobile" inputmode="tel" />
                </label>
              </div>
              <div class="pair">
                <label class="field">
                  <span>Family doctor / physician <em class="hi">पारिवारिक डॉक्टर</em></span>
                  <input type="text" name="familyDoctor" />
                </label>
                <label class="field">
                  <span>Their phone <em class="hi">उनका फ़ोन</em></span>
                  <input type="tel" name="familyDoctorPhone" inputmode="tel" />
                </label>
              </div>
            </fieldset>

            <!-- 5 -->
            <fieldset>
              <legend><span class="n">5</span> Medical history <span class="hi">स्वास्थ्य संबंधी जानकारी</span></legend>
              <p class="hint">
                Your general health affects what dental treatment is safe. Tick anything you have,
                or have ever had. Leave the rest blank.<br />
                <span class="hi">जो आपको है या कभी रहा है, उस पर निशान लगाएँ। बाकी खाली छोड़ दें।</span>
              </p>

              <div class="grid-checks">
                {conditions.map(([en, hi]) => (
                  <label class="check check--tile">
                    <input type="checkbox" name="condition" value={en} />
                    <span>{en} <em class="hi">{hi}</em></span>
                  </label>
                ))}
              </div>

              <label class="field">
                <span>Any other illness, operation or hospital admission <em class="hi">कोई अन्य बीमारी, ऑपरेशन या अस्पताल में भर्ती</em></span>
                <textarea name="otherIllness" rows="2"></textarea>
              </label>

              <h3 class="sub">Medicines <span class="hi">दवाइयाँ</span></h3>
              <div class="grid-checks">
                {medicineFlags.map(([en, hi]) => (
                  <label class="check check--tile">
                    <input type="checkbox" name="medFlag" value={en} />
                    <span>{en} <em class="hi">{hi}</em></span>
                  </label>
                ))}
              </div>

              <label class="field">
                <span>
                  Medicines you take now <em class="hi">वर्तमान में ली जा रही दवाइयाँ</em>
                  <small>Include Ayurvedic, homoeopathic and herbal medicines, and supplements.</small>
                </span>
                <textarea name="medicines" rows="3"></textarea>
              </label>

              <h3 class="sub">Allergies <span class="hi">एलर्जी</span></h3>
              <div class="grid-checks">
                {allergies.map(([en, hi]) => (
                  <label class="check check--tile">
                    <input type="checkbox" name="allergy" value={en} />
                    <span>{en} <em class="hi">{hi}</em></span>
                  </label>
                ))}
              </div>
              <label class="field">
                <span>Other allergies, and what happened <em class="hi">अन्य एलर्जी, और क्या हुआ था</em></span>
                <textarea name="allergyDetail" rows="2"></textarea>
              </label>

              <label class="check">
                <input type="checkbox" name="anaesthesiaProblem" />
                <span>I have had a problem with general anaesthesia or sedation <em class="hi">जनरल एनेस्थीसिया से परेशानी हुई है</em></span>
              </label>
            </fieldset>

            <!-- 6 -->
            <fieldset>
              <legend><span class="n">6</span> Dental history <span class="hi">दाँतों संबंधी विवरण</span></legend>

              <label class="field">
                <span>Reason for your visit <em class="hi">आने का कारण</em> <b class="req">*</b></span>
                <select name="visitReason" required>
                  <option value="">—</option>
                  <option>Pain / दर्द</option>
                  <option>Check-up / जाँच</option>
                  <option>Cleaning / सफ़ाई</option>
                  <option>Broken tooth / टूटा हुआ दाँत</option>
                  <option>Cosmetic / सुंदरता</option>
                  <option>Second opinion / दूसरी राय</option>
                  <option>Follow-up / पुनः जाँच</option>
                  <option>Other / अन्य</option>
                </select>
              </label>

              <label class="field">
                <span>If in pain, describe it <em class="hi">यदि दर्द है, तो बताएँ</em>
                  <small>Which tooth, since when, and what makes it worse.</small>
                </span>
                <textarea name="painDetail" rows="2"></textarea>
              </label>

              <div class="pair">
                <label class="field">
                  <span>Last dental visit <em class="hi">पिछली दंत जाँच</em></span>
                  <input type="text" name="lastVisit" placeholder="e.g. March 2024" />
                </label>
                <label class="field">
                  <span>Previous clinic / dentist <em class="hi">पिछला क्लिनिक</em></span>
                  <input type="text" name="previousClinic" />
                </label>
              </div>

              <h3 class="sub">Anything you have noticed <span class="hi">जो आपने महसूस किया हो</span></h3>
              <div class="grid-checks">
                {symptoms.map(([en, hi]) => (
                  <label class="check check--tile">
                    <input type="checkbox" name="symptom" value={en} />
                    <span>{en} <em class="hi">{hi}</em></span>
                  </label>
                ))}
              </div>

              <h3 class="sub">Dental treatment you have had before <span class="hi">पहले करवाया गया दंत उपचार</span></h3>
              <div class="grid-checks">
                {pastTreatment.map(([en, hi]) => (
                  <label class="check check--tile">
                    <input type="checkbox" name="pastTreatment" value={en} />
                    <span>{en} <em class="hi">{hi}</em></span>
                  </label>
                ))}
              </div>

              <label class="check">
                <input type="checkbox" name="numbTrouble" />
                <span>I have had trouble getting numb with a dental injection <em class="hi">सुन्न करने के इंजेक्शन से दाँत ठीक से सुन्न नहीं हुआ</em></span>
              </label>

              <label class="field">
                <span>How nervous are you about dental treatment? <em class="hi">आप कितना घबराते हैं?</em>
                  <small>1 = not at all, 10 = very nervous</small>
                </span>
                <input type="range" name="anxiety" min="1" max="10" value="3" class="range" />
                <output class="range-out" id="anxietyOut">3</output>
              </label>
            </fieldset>

            <!-- 7 -->
            <fieldset>
              <legend><span class="n">7</span> Habits &amp; oral care <span class="hi">आदतें एवं मुँह की देखभाल</span></legend>
              <p class="hint">
                Please answer honestly — tobacco and areca nut directly affect your oral health and
                what treatment we advise. Nothing here is judged.<br />
                <span class="hi">कृपया सही जानकारी दें — इसका सीधा असर आपके मुँह के स्वास्थ्य पर पड़ता है।</span>
              </p>

              <div class="grid-checks">
                {tobacco.map(([en, hi]) => (
                  <label class="check check--tile">
                    <input type="checkbox" name="tobacco" value={en} />
                    <span>{en} <em class="hi">{hi}</em></span>
                  </label>
                ))}
              </div>

              <div class="pair">
                <label class="field">
                  <span>If you use any, how much and for how long? <em class="hi">कितना और कितने वर्षों से?</em></span>
                  <input type="text" name="tobaccoDetail" placeholder="e.g. 10 a day for 15 years" />
                </label>
                <label class="field">
                  <span>Alcohol <em class="hi">शराब</em></span>
                  <select name="alcohol">
                    <option value="">—</option>
                    <option>Never / कभी नहीं</option>
                    <option>Occasionally / कभी-कभार</option>
                    <option>Regularly / नियमित रूप से</option>
                  </select>
                </label>
              </div>

              <div class="pair">
                <label class="field">
                  <span>Brushing <em class="hi">ब्रश</em></span>
                  <select name="brushing">
                    <option value="">—</option>
                    <option>Twice a day / दिन में दो बार</option>
                    <option>Once a day / दिन में एक बार</option>
                    <option>Not daily / रोज़ नहीं</option>
                  </select>
                </label>
                <label class="field">
                  <span>Floss or interdental brush <em class="hi">फ़्लॉस</em></span>
                  <select name="floss">
                    <option value="">—</option>
                    <option>Daily / रोज़</option>
                    <option>Sometimes / कभी-कभी</option>
                    <option>Never / कभी नहीं</option>
                  </select>
                </label>
              </div>

              <div class="pair">
                <label class="field">
                  <span>Drinking water <em class="hi">पीने का पानी</em></span>
                  <select name="water">
                    <option value="">—</option>
                    <option>Municipal supply / नगर निगम</option>
                    <option>Borewell or handpump / बोरवेल</option>
                    <option>RO or filtered / आर.ओ.</option>
                    <option>Packaged / पैकेज्ड</option>
                  </select>
                </label>
                <label class="field">
                  <span>Sweet or aerated drinks per day <em class="hi">मीठे पेय प्रतिदिन</em></span>
                  <input type="number" name="sweetDrinks" min="0" max="30" inputmode="numeric" />
                </label>
              </div>

              <label class="check">
                <input type="checkbox" name="fluorosis" />
                <span>I or someone in my family has been told we have fluorosis (yellow-brown stains) <em class="hi">फ़्लोरोसिस बताया गया है</em></span>
              </label>
            </fieldset>

            <!-- 8 -->
            <fieldset>
              <legend><span class="n">8</span> X-rays <span class="hi">एक्स-रे</span></legend>
              <label class="check">
                <input type="checkbox" name="xrayConsent" />
                <span>
                  I consent to dental X-rays (IOPA, OPG, CBCT) being taken when the dentist
                  considers them necessary. I understand the radiation dose is low and the reason
                  will be explained to me.
                  <em class="hi">मैं सहमति देता/देती हूँ कि आवश्यक होने पर दंत एक्स-रे लिए जा सकते हैं।</em>
                </span>
              </label>
              <label class="field">
                <span>Recent X-rays from another clinic? <em class="hi">अन्य क्लिनिक के हाल के एक्स-रे?</em></span>
                <input type="text" name="priorXrays" placeholder="Clinic name, or leave blank" />
              </label>
            </fieldset>

            <!-- 9 -->
            <fieldset>
              <legend><span class="n">9</span> Fees &amp; clinic policy <span class="hi">शुल्क एवं नीति</span></legend>
              <p class="hint">Please read and tick each one. <span class="hi">कृपया पढ़कर निशान लगाएँ।</span></p>
              {policies.map(([en, hi]) => (
                <label class="check">
                  <input type="checkbox" name="policy" value={en.slice(0, 60)} required />
                  <span>{en} <em class="hi">{hi}</em></span>
                </label>
              ))}
            </fieldset>

            <!-- 10 -->
            <fieldset class="consent">
              <legend><span class="n">10</span> Consent &amp; declaration <span class="hi">सहमति एवं घोषणा</span></legend>

              <div class="dpdp">
                <h3>What happens to what you have written</h3>
                <ul>
                  <li>
                    It is collected to provide dental care, keep your clinical record, process
                    payment and, if you claim, support an insurance or scheme claim.
                  </li>
                  <li>
                    <strong>Submitting this form sends your answers — including your medical
                    history — over the internet to the clinic's email inbox, using the form
                    service Web3Forms.</strong> If you would rather not send health information
                    this way, <a href="/forms/">print the form</a> and bring it instead. Nobody
                    will mind.
                  </li>
                  <li>
                    It may be shared with the treating dentist and staff, dental laboratories,
                    referred specialists, diagnostic centres, and your insurer or TPA where
                    relevant to your care or claim.
                  </li>
                  <li>
                    It is handled under the Digital Personal Data Protection Act, 2023. You may
                    ask to see it, ask us to correct it, or withdraw consent at any time by
                    writing to <a href="mailto:privacy@srishankaradental.com">privacy@srishankaradental.com</a>.
                    Withdrawing consent may affect our ability to continue treatment.
                  </li>
                </ul>
              </div>

              <label class="check check--strong">
                <input type="checkbox" name="declaration" required />
                <span>
                  The information I have given is true and complete to the best of my knowledge,
                  and I agree to it being collected and used as described above. I will tell the
                  clinic if my health, medicines or contact details change.
                  <em class="hi">दी गई जानकारी सत्य एवं पूर्ण है, और मैं इसके उपयोग से सहमत हूँ।</em>
                  <b class="req">*</b>
                </span>
              </label>

              <p class="hint">Optional <span class="hi">वैकल्पिक</span></p>
              <label class="check">
                <input type="checkbox" name="optIn" value="Appointment reminders by SMS or WhatsApp" />
                <span>Appointment reminders by SMS or WhatsApp <em class="hi">अपॉइंटमेंट की याद दिलाना</em></span>
              </label>
              <label class="check">
                <input type="checkbox" name="optIn" value="Recall reminders for check-ups and cleaning" />
                <span>Recall reminders for check-ups and cleaning <em class="hi">जाँच एवं सफ़ाई के लिए याद दिलाना</em></span>
              </label>

              <div class="signed">
                <label class="field">
                  <span>Type your full name to sign <em class="hi">हस्ताक्षर हेतु अपना नाम लिखें</em> <b class="req">*</b></span>
                  <input type="text" name="signature" required autocomplete="off" />
                </label>
                <p class="hint">
                  If you are signing for someone else, put your own name here and give your
                  relationship in section 3.
                </p>
              </div>

              <p class="note-final">
                This form registers you as a patient. Separate written consent is taken before any
                surgical or major procedure.
                <span class="hi">यह फ़ॉर्म केवल पंजीकरण के लिए है।</span>
              </p>
            </fieldset>

            <!-- honeypot -->
            <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

            <div class="actions">
              <button type="submit" class="btn btn--primary" id="submitBtn">Submit to the clinic</button>
              <button type="button" class="btn btn--ghost" id="clearBtn">Clear the form</button>
            </div>
            <p class="saved" id="savedNote" hidden>Saved in this browser</p>
            <div class="formError" id="formError" hidden></div>
          </form>

          <div class="done" id="done" hidden>
            <h2>Thank you — we have your form</h2>
            <p>
              It has reached the clinic. There is nothing else you need to do before your
              appointment, other than bring your medicines list and, if you are claiming, your
              insurance or scheme card.
            </p>
            <p>
              If anything changes before your visit — a new medicine, a new symptom — please tell
              us on <a href={clinic.phoneHref}>{clinic.phone}</a>.
            </p>
            <p><a href="/" class="btn btn--ghost">Back to the website</a></p>
          </div>
        </>
      )}
    </div>
  </section>
</Base>

<script is:inline define:vars={{ accessKey: key, clinicName: clinic.name }}>
  const form = document.getElementById('reg');
  if (form) {
    const KEY = 'ssdc-registration-draft';
    const savedNote = document.getElementById('savedNote');
    const errorBox = document.getElementById('formError');
    const submitBtn = document.getElementById('submitBtn');

    /* ---- anxiety slider read-out ---- */
    const range = form.querySelector('input[name="anxiety"]');
    const out = document.getElementById('anxietyOut');
    if (range && out) {
      const sync = () => { out.textContent = range.value; };
      range.addEventListener('input', sync);
      sync();
    }

    /* ---- draft, kept in this browser only ---- */
    const collect = () => {
      const d = {};
      for (const el of form.elements) {
        if (!el.name || el.name === 'botcheck') continue;
        if (el.type === 'checkbox') {
          if (el.checked) (d[el.name] ||= []).push(el.value === 'on' ? true : el.value);
        } else if (el.value) {
          d[el.name] = el.value;
        }
      }
      return d;
    };

    const restore = () => {
      let d;
      try { d = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return; }
      if (!d) return;
      for (const el of form.elements) {
        if (!el.name || !(el.name in d)) continue;
        const v = d[el.name];
        if (el.type === 'checkbox') {
          if (Array.isArray(v)) el.checked = v.includes(el.value) || (v.includes(true) && el.value === 'on');
        } else {
          el.value = v;
        }
      }
      if (range && out) out.textContent = range.value;
      savedNote.hidden = false;
      savedNote.textContent = 'Draft restored from this browser';
    };

    let saveTimer;
    const save = () => {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        try {
          localStorage.setItem(KEY, JSON.stringify(collect()));
          savedNote.hidden = false;
          savedNote.textContent = 'Saved in this browser';
        } catch { /* private browsing — the form still works, it just won't persist */ }
      }, 400);
    };

    try { restore(); } catch { /* ignore */ }
    form.addEventListener('input', save);
    form.addEventListener('change', save);

    document.getElementById('clearBtn').addEventListener('click', () => {
      if (!confirm('Clear everything you have entered on this form?')) return;
      try { localStorage.removeItem(KEY); } catch { /* ignore */ }
      form.reset();
      if (range && out) out.textContent = range.value;
      savedNote.hidden = true;
    });

    /* ---- build a readable email rather than 120 raw fields ---- */
    const list = (d, k) => (d[k] || []).join(', ');
    const line = (label, v) => (v ? `${label}: ${v}\n` : '');

    const compose = (d) => ({
      'Patient': [
        line('Name', d.fullName),
        line("Father's / husband's name", d.guardianName),
        line('Date of birth', d.dob), line('Age', d.age),
        line('Gender', d.gender), line('Blood group', d.bloodGroup),
        line('Occupation', d.occupation), line('Preferred language', d.language),
      ].join('').trim(),

      'Contact': [
        line('Mobile', d.mobile), line('Alternate', d.mobileAlt),
        line('WhatsApp', d.whatsapp), line('Email', d.email),
        line('Preferred contact', d.contactPref),
        line('Address', [d.address, d.city, d.state, d.pin].filter(Boolean).join(', ')),
        line('Heard about us via', d.referredBy),
      ].join('').trim(),

      'Schemes and insurance': [
        line('ABHA', d.abha), line('Scheme', d.scheme), line('Card no.', d.schemeCard),
        line('Insurer / TPA', d.insurer), line('Policy no.', d.policyNo),
        line('Cashless requested', d.cashless ? 'Yes' : ''),
      ].join('').trim() || 'None given',

      'Responsible person (under 18)': [
        line('Name', d.responsibleName), line('Relationship', d.responsibleRel),
        line('Mobile', d.responsibleMobile),
      ].join('').trim() || 'Not applicable',

      'Emergency contact': [
        line('Name', d.emergencyName), line('Relationship', d.emergencyRel),
        line('Mobile', d.emergencyMobile),
        line('Family doctor', d.familyDoctor), line('Doctor phone', d.familyDoctorPhone),
      ].join('').trim() || 'Not given',

      '** MEDICAL ALERTS **': [
        line('Conditions reported', list(d, 'condition')),
        line('Medicines / flags', list(d, 'medFlag')),
        line('Allergies', list(d, 'allergy')),
        line('Allergy detail', d.allergyDetail),
        line('Anaesthesia problem', d.anaesthesiaProblem ? 'YES' : ''),
        line('Current medicines', d.medicines),
        line('Other illness / operations', d.otherIllness),
      ].join('').trim() || 'Nothing reported',

      'Dental history': [
        line('Reason for visit', d.visitReason),
        line('Pain detail', d.painDetail),
        line('Last visit', d.lastVisit), line('Previous clinic', d.previousClinic),
        line('Noticed', list(d, 'symptom')),
        line('Previous treatment', list(d, 'pastTreatment')),
        line('Trouble getting numb', d.numbTrouble ? 'YES' : ''),
        line('Anxiety (1-10)', d.anxiety),
      ].join('').trim(),

      'Habits and oral care': [
        line('Tobacco / areca', list(d, 'tobacco')),
        line('Detail', d.tobaccoDetail),
        line('Alcohol', d.alcohol),
        line('Brushing', d.brushing), line('Floss', d.floss),
        line('Water', d.water), line('Sweet drinks per day', d.sweetDrinks),
        line('Fluorosis reported', d.fluorosis ? 'Yes' : ''),
      ].join('').trim(),

      'Consents': [
        line('X-ray consent', d.xrayConsent ? 'Given' : 'NOT given'),
        line('Prior X-rays held at', d.priorXrays),
        line('Clinic policy acknowledged', (d.policy || []).length + ' of 4'),
        line('Declaration signed by', d.signature),
        line('Opted in to', list(d, 'optIn') || 'nothing'),
      ].join('').trim(),
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.hidden = true;

      if (!form.reportValidity()) return;

      const d = collect();
      const payload = {
        access_key: accessKey,
        subject: `Patient registration — ${d.fullName || 'no name given'}`,
        from_name: clinicName,
        botcheck: false,
        ...compose(d),
      };

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok || out.success === false) throw new Error(out.message || `HTTP ${res.status}`);

        try { localStorage.removeItem(KEY); } catch { /* ignore */ }
        form.hidden = true;
        savedNote.hidden = true;
        document.getElementById('done').hidden = false;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch (err) {
        errorBox.hidden = false;
        errorBox.innerHTML =
          '<strong>That did not send.</strong> Your answers are still saved in this browser, ' +
          'so nothing is lost — please try again in a moment. If it keeps failing, ' +
          '<a href="/forms/">print the form</a> and bring it, or phone the clinic.';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit to the clinic';
      }
    });
  }
</script>

<style>
  .form-page h1 { margin-bottom: .4rem; }
  .pain-note {
    background: var(--orange-100); border-left: 4px solid var(--orange-500);
    padding: .8rem 1rem; border-radius: 8px; margin: 1.25rem 0 2rem;
  }
  .hi { font-size: .875em; color: var(--ink-muted); }

  fieldset {
    border: 1px solid var(--line); border-radius: var(--radius);
    padding: 1.25rem 1.25rem 1.4rem; margin: 0 0 1.5rem; min-width: 0;
  }
  legend {
    font-family: var(--font-head); font-weight: 600; font-size: 1.15rem;
    color: var(--navy-800); padding: 0 .5rem; display: flex; align-items: baseline; gap: .5rem;
  }
  legend .n {
    display: inline-grid; place-items: center; width: 1.5rem; height: 1.5rem;
    border-radius: 50%; background: var(--orange-100); color: var(--orange-700);
    font-size: .85rem;
  }
  .sub { font-size: 1rem; margin: 1.4rem 0 .5rem; color: var(--navy-800); }
  .hint { font-size: .875rem; color: var(--ink-muted); margin-bottom: .9rem; }

  .field { display: block; margin-bottom: .9rem; }
  .field > span { display: block; font-weight: 500; margin-bottom: .3rem; font-size: .95rem; }
  .field small { display: block; font-weight: 400; color: var(--ink-muted); font-size: .8rem; }
  .req { color: var(--orange-700); }

  input[type='text'], input[type='tel'], input[type='email'], input[type='date'],
  input[type='number'], select, textarea {
    width: 100%; padding: .6rem .7rem; font: inherit; font-size: .95rem;
    border: 1px solid var(--navy-300); border-radius: 8px; background: #fff; color: var(--ink);
  }
  textarea { resize: vertical; }
  input:focus-visible, select:focus-visible, textarea:focus-visible {
    outline: 3px solid var(--orange-300); outline-offset: 1px; border-color: var(--navy-700);
  }
  /* :user-invalid, not :invalid — an empty required field should not look like
     an error before anyone has touched it. */
  input:user-invalid, select:user-invalid, textarea:user-invalid {
    border-color: var(--orange-600); background: var(--orange-100);
  }

  .pair, .trio { display: grid; gap: .9rem; }
  @media (min-width: 620px) {
    .pair { grid-template-columns: 1fr 1fr; }
    .trio { grid-template-columns: 1fr 1fr 1fr; }
  }

  .check { display: flex; gap: .6rem; align-items: flex-start; margin-bottom: .6rem; font-size: .95rem; }
  .check input { margin-top: .25rem; width: 1.05rem; height: 1.05rem; accent-color: var(--navy-700); flex-shrink: 0; }
  .check em { font-style: normal; }
  .check--strong {
    background: var(--navy-50); border: 1px solid var(--navy-300);
    border-radius: 10px; padding: .9rem 1rem; margin: 1rem 0;
  }

  .grid-checks { display: grid; gap: .1rem; margin-bottom: 1rem; }
  @media (min-width: 620px) { .grid-checks { grid-template-columns: 1fr 1fr; gap: .1rem 1.25rem; } }
  .check--tile { padding: .35rem .4rem; border-radius: 6px; margin-bottom: 0; }
  .check--tile:hover { background: var(--navy-50); }

  .range { width: 100%; accent-color: var(--orange-500); }
  .range-out {
    display: inline-block; min-width: 2rem; text-align: center; font-weight: 600;
    color: var(--navy-700);
  }

  .consent .dpdp {
    background: var(--navy-50); border-radius: 10px; padding: 1rem 1.15rem; margin-bottom: 1rem;
  }
  .consent .dpdp h3 { font-size: 1rem; margin-bottom: .5rem; }
  .consent .dpdp ul { margin: 0; padding-left: 1.1rem; font-size: .9rem; }
  .consent .dpdp li { margin-bottom: .55rem; }
  .consent .dpdp li:last-child { margin-bottom: 0; }
