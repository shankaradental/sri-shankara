---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---
<Base
  title="Dental treatments"
  description="Treatments at Sri Shankara Dental Clinic, Dehradun — preventive care, scaling and polishing, tooth-coloured fillings, root canal treatment, crowns and bridges, extractions, implants, braces and aligners, whitening, and emergency care."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Treatments</p>
      <h1>What we treat</h1>
      <p class="lede">
        Each page explains what the treatment involves, roughly how long it
        takes, what recovery is like, and what the alternatives are. Costs
        depend on the individual case and are confirmed at your consultation.
      </p>

      <div class="grid grid--2" style="margin-top:2.5rem">
        {services.map((s) => (
          <a class="card card--link" href={`/services/${s.id}/`}>
            <h3>{s.data.title}</h3>
            <p>{s.data.summary}</p>
            {s.data.duration && <p class="meta">Typical appointment: {s.data.duration}</p>}
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .meta { color: var(--ink-muted); font-size: .875rem; margin-bottom: 0; }
</style>
